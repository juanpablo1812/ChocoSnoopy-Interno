# ==========================================
# Variables de entorno de Chocosnoopy
# Copia este archivo como ".env.local" y rellena los valores.
# En Vercel, agrega estas mismas variables en Project Settings > Environment Variables.
# ==========================================

# URL de tu proyecto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave publica "anon" (segura para el navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# Clave "service_role" (SECRETA: solo se usa en el servidor, nunca en el navegador)
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
